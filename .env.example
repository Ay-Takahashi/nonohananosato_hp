# サイトのベースURL（本番環境 / GitHub Pages）
# OGP・sitemap.xml・robots.txt の出力に使用する
NEXT_PUBLIC_SITE_URL=https://nonohananosato.jp

# GitHub Pagesなどでサブディレクトリにデプロイする場合のベースパス
# 例: /homepage の場合は NEXT_PUBLIC_BASE_PATH=/homepage
NEXT_PUBLIC_BASE_PATH=

# Google Search Consoleの検証コード（オプション）
# NEXT_PUBLIC_GOOGLE_VERIFICATION=your-google-verification-code
